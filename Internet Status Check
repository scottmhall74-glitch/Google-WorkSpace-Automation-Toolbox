//Put this into a Google Spreadsheet Script Editor and set the trigger to be every 5 or 10 minutes.

function monitorWebsites() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const checkSheet = ss.getSheetByName("CheckList");
  const emailSheet = ss.getSheetByName("Email List");
  
  // 1. Get the list of emails from the "Email List" tab
  const emailData = emailSheet.getRange(2, 1, emailSheet.getLastRow() - 1, 1).getValues();
  const emailRecipients = emailData.map(row => row[0]).filter(email => email !== "").join(",");
  
  // 2. Get the website data from "CheckList"
  const lastRow = checkSheet.getLastRow();
  if (lastRow < 2) return; 

  const data = checkSheet.getRange(2, 1, lastRow - 1, 3).getValues(); 
  const now = new Date();
  const formattedTime = Utilities.formatDate(now, Session.getScriptTimeZone(), "MM-dd-yyyy HH:mm:ss");
  
  const MAX_RETRIES = 3; 
  const RETRY_DELAY_MS = 2500; 
  
  for (let i = 0; i < data.length; i++) {
    const rowNum = i + 2; 
    const siteName = data[i][0]; // Col A
    const url = data[i][1];      // Col B
    const previousStatus = data[i][2]; // Col C (0, 1, or 2)
    
    if (!url) continue; 
    
    let isReachable = false;
    
    // Quick retry loop for immediate micro-blips
    for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {
      try {
        const response = UrlFetchApp.fetch(url, {
          muteHttpExceptions: true, 
          followRedirects: true
        });
        
        const code = response.getResponseCode();
        if ((code >= 200 && code < 400) || code === 401 || code === 403) {
          isReachable = true;
          break; 
        }
      } catch (e) {
        // Fetch failed
      }
      
      if (attempt < MAX_RETRIES) {
        Utilities.sleep(RETRY_DELAY_MS);
      }
    }
    
    // Update the "Last Checked" timestamp
    checkSheet.getRange(rowNum, 4).setValue(now).setNumberFormat("yyyy-mm-dd HH:mm:ss");

    // --- STATUS LOGIC ---
    if (isReachable) {
      // THE SITE IS ONLINE
      if (previousStatus === 2) {
        // Was confirmed down (2), now up -> SEND RECOVERY EMAIL & reset to 0
        checkSheet.getRange(rowNum, 3).setValue(0);
        if (emailRecipients) {
          MailApp.sendEmail({
            to: emailRecipients,
            subject: `Back Online: ${siteName}`,
            body: `Good news! The website "${siteName}" (${url}) is now back online as of ${formattedTime}. Status reset to 0.`
          });
        }
      } else if (previousStatus === 1) {
        // Was an unconfirmed blip (1), now up -> NO EMAIL, just reset to 0
        checkSheet.getRange(rowNum, 3).setValue(0);
      }
      // If previousStatus was 0, it stayed up -> Do nothing.
      
    } else {
      // THE SITE IS OFFLINE
      if (previousStatus === 0) {
        // Was up (0), now down -> NO EMAIL, mark as unconfirmed down (1)
        checkSheet.getRange(rowNum, 3).setValue(1); 
        
      } else if (previousStatus === 1) {
        // Was unconfirmed down (1), still down -> SEND ALERT EMAIL & mark confirmed (2)
        checkSheet.getRange(rowNum, 3).setValue(2); 
        if (emailRecipients) {
          MailApp.sendEmail({
            to: emailRecipients,
            subject: `Alert: ${siteName} is Offline`,
            body: `The website "${siteName}" (${url}) has failed two consecutive checks and is confirmed down as of ${formattedTime}. Status updated to 2.`
          });
        }
      }
      // If previousStatus was 2, it stayed down -> Do nothing, alert already sent.
    }
  }
}
